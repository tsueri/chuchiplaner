# Chuchiplaner — Environment Variables
# Copy this file to .env and adjust values as needed.
# The .env file is gitignored.

# --- App ---
# CHUCHI_APP_NAME=Chuchiplaner
# CHUCHI_APP_VERSION=0.1.0

# Database URL (SQLAlchemy format). For local dev, use the default.
# In Docker Compose, this points to ./data/chuchiplaner.db (mounted volume).
# CHUCHI_DATABASE_URL=sqlite+aiosqlite:///./chuchiplaner.db

# Allowed CORS origins as a comma-separated list. Empty by default.
# In production, set this to your frontend origin(s):
#   CHUCHI_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# For local dev with Vite:
#   CHUCHI_CORS_ORIGINS=http://localhost:5173
# CHUCHI_CORS_ORIGINS=

# Whether new users can register. Set to false to disable public signup.
# CHUCHI_SIGNUP_ENABLED=false

# If non-empty, registration requires a valid household invite code.
# CHUCHI_ADMIN_SIGNUP_CODE=

# --- Session cookie ---
# CHUCHI_COOKIE_SECURE=false   # set to true behind HTTPS
# CHUCHI_COOKIE_SAMESITE=strict
# CHUCHI_COOKIE_MAX_AGE_SECONDS=604800
# CHUCHI_COOKIE_HTTPONLY=true
# CHUCHI_COOKIE_NAME=session_token

# --- Reverse proxy / HTTPS ---
# Enable when the app runs behind a reverse proxy (nginx, Caddy, Traefik, etc.):
# CHUCHI_TRUST_PROXY_HEADERS=false   # set to true to read client IP from X-Forwarded-For for rate limiting
# FORWARDED_ALLOW_IPS=127.0.0.1      # uvicorn: trusted proxy IPs (use 172.16.0.0/12 for Docker, or * if proxy is on same host)

# --- Frontend ---
# Backend URL for the Vite dev server proxy. Only needed in Docker Compose dev.
# VITE_BACKEND_URL=http://localhost:8000

# --- Backup sidecar (Docker Compose only) ---
# CHUCHI_DB_PATH=/data/chuchiplaner.db
# CHUCHI_BACKUP_DIR=/backups
# CHUCHI_BACKUP_RETENTION=7
# CHUCHI_BACKUP_INTERVAL=86400
