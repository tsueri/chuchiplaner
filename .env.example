# Chuchiplaner — Environment Variables
# Copy this file to .env and adjust values as needed.
# The .env file is gitignored.

# --- App ---
# CHUCHI_APP_NAME=Chuchiplaner
# CHUCHI_APP_VERSION=0.1.0

# Database URL (SQLAlchemy format). For local dev, use the default.
# In Docker Compose, this points to ./data/chuchiplaner.db (mounted volume).
# CHUCHI_DATABASE_URL=sqlite+aiosqlite:///./chuchiplaner.db

# Allowed CORS origins as a JSON list. Default allows the Vite dev server.
# CHUCHI_CORS_ORIGINS=["http://localhost:5173"]

# --- Backup sidecar (Docker Compose only) ---
# CHUCHI_DB_PATH=/data/chuchiplaner.db
# CHUCHI_BACKUP_DIR=/backups
# CHUCHI_BACKUP_RETENTION=7
# CHUCHI_BACKUP_INTERVAL=86400
